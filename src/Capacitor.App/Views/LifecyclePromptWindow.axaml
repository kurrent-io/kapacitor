<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:rxui="clr-namespace:ReactiveUI.Avalonia;assembly=ReactiveUI.Avalonia"
                     xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
                     x:Class="Capacitor.App.Views.LifecyclePromptWindow"
                     x:TypeArguments="vm:LifecyclePromptViewModel"
                     x:DataType="vm:LifecyclePromptViewModel"
                     Title="{Binding Title}"
                     Icon="avares://Kurrent Capacitor/Assets/kcap-icon.png"
                     Width="440" Height="260"
                     CanResize="False" Topmost="True" WindowStartupLocation="CenterOwner">
    <!-- Fixed Width/Height + a ScrollViewer, deliberately NOT SizeToContent="Height": Avalonia's
         headless platform never completes measure for SizeToContent.Height + wrapped
         multi-paragraph TextBlocks (Task 21's carried-forward finding — BuildConfirmForceStopWindow
         has the same latent shape). Explicit Width on both TextBlocks below is the second half of
         that fix — wrap has a bound to terminate against either way. -->
    <Grid Margin="20" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding Disclosure}" TextWrapping="Wrap" Width="380" />
                <TextBlock Text="{Binding DegradedPathText}" TextWrapping="Wrap" Width="380"
                           IsVisible="{Binding DegradedPathText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Not now" Command="{Binding DeclineCommand}" IsCancel="True"
                    IsVisible="{Binding ShowDeclineButton}" />
            <Button Content="{Binding AcceptButtonText}" Command="{Binding AcceptCommand}" IsDefault="True" />
        </StackPanel>
    </Grid>
</rxui:ReactiveWindow>
