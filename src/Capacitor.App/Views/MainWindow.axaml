<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:rxui="clr-namespace:ReactiveUI.Avalonia;assembly=ReactiveUI.Avalonia"
                     xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
                     x:Class="Capacitor.App.Views.MainWindow"
                     x:TypeArguments="vm:MainWindowViewModel"
                     x:DataType="vm:MainWindowViewModel"
                     Title="Kurrent Capacitor Desktop"
                     Width="480" Height="320">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Kurrent Capacitor Desktop" FontSize="18" FontWeight="Bold" />

        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock x:Name="DaemonIdentityText" Text="{Binding DaemonName}" />
            <TextBlock Text="/" />
            <TextBlock x:Name="DaemonVersionText" Text="{Binding DaemonVersion}" />
        </StackPanel>

        <TextBlock x:Name="ServerUrlText" Text="{Binding ServerUrl}" />
        <TextBlock x:Name="ConnectionText" Text="{Binding ConnectionText}" />
        <TextBlock x:Name="AgentCountText" Text="{Binding AgentCountText}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartButton" Content="Start daemon" Command="{Binding StartDaemonCommand}" />
            <Button x:Name="RetryButton" Content="Retry" Command="{Binding RetryCommand}" />
        </StackPanel>

        <TextBlock x:Name="StartMessageText" Text="{Binding StartMessage}" />
        <TextBlock x:Name="ReasonText" Text="{Binding Reason}" />
    </StackPanel>
</rxui:ReactiveWindow>
