<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Spec §4 tray glyphs: 32x32 coordinate space, one StreamGeometry per TrayState. Each
         geometry is a complete, self-contained shape drawn with a single Fill (TrayIconRenderer)
         in mid-gray #808080 — no separate stroke pass. Trivial shapes: a ring for Stopped, the
         same ring with its right inner half also filled for Connecting (EvenOdd fill rule via the
         leading F0), a plain filled disc for Idle/Running (Running additionally overlays the
         CountBadge text in the renderer), and a triangle with an exclamation cutout for
         Attention. -->
    <StreamGeometry x:Key="TrayGlyphStopped">F0 M5,16 A11,11 0 1 0 27,16 A11,11 0 1 0 5,16 Z M9,16 A7,7 0 1 0 23,16 A7,7 0 1 0 9,16 Z</StreamGeometry>
    <StreamGeometry x:Key="TrayGlyphConnecting">F0 M5,16 A11,11 0 1 0 27,16 A11,11 0 1 0 5,16 Z M9,16 A7,7 0 1 0 23,16 A7,7 0 1 0 9,16 Z M16,9 A7,7 0 0 1 16,23 L16,16 Z</StreamGeometry>
    <StreamGeometry x:Key="TrayGlyphIdle">M5,16 A11,11 0 1 0 27,16 A11,11 0 1 0 5,16 Z</StreamGeometry>
    <StreamGeometry x:Key="TrayGlyphRunning">M5,16 A11,11 0 1 0 27,16 A11,11 0 1 0 5,16 Z</StreamGeometry>
    <StreamGeometry x:Key="TrayGlyphAttention">F0 M16,5 L28,26 L4,26 Z M15,12 L17,12 L17,19 L15,19 Z M15,21 L17,21 L17,23 L15,23 Z</StreamGeometry>
</ResourceDictionary>
