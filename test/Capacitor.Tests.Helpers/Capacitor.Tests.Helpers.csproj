<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <!-- Core only. The guards pin Core-owned statics (KCAP_CONFIG_DIR, DaemonLockPaths,
             McpMarker, AuthProviderCache); nothing here needs the CLI or daemon assemblies, and
             referencing them would make every test project link them transitively. -->
        <ProjectReference Include="..\..\src\Capacitor.Cli.Core\Capacitor.Cli.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Guards/ holds process-global pins that every test assembly needs. They must use the
             [BeforeEvery(Assembly)] / [AfterEvery(Assembly)] variants, NOT [Before(Assembly)]:
             the non-Every form is scoped to the assembly that declares it, and this one holds no
             tests, so those hooks would silently never run. Verified — with [Before(Assembly)],
             DaemonPathsIsolationTests resolved the developer's real ~/.config/kcap/daemons. -->
        <PackageReference Include="TUnit.Core" />
        <!-- AuthFixtures substitutes the façade's tenant picker. -->
        <PackageReference Include="NSubstitute" />
    </ItemGroup>
</Project>
