<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- DummyProcess declares a chmod LibraryImport for the native-shim test fixtures. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Capacitor.Cli\Capacitor.Cli.csproj" />
        <ProjectReference Include="..\..\src\Capacitor.Cli.Daemon\Capacitor.Cli.Daemon.csproj" />
        <ProjectReference Include="..\Capacitor.Cli.Tests.Unit.NativeTestHost\Capacitor.Cli.Tests.Unit.NativeTestHost.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="Tomlyn" />
        <PackageReference Include="WireMock.Net" />
        <PackageReference Include="NSubstitute" />
    </ItemGroup>
    <ItemGroup>
        <!-- Embedded (not read off disk) so TranscriptReadSharingInvariantTests never has to locate a
             source file at run time: [CallerFilePath] would be rewritten by deterministic-build path
             mapping, and a test assembly can be run without its checkout. The resource is compiled from
             the same tree as the assembly, so it is always the current source. -->
        <EmbeddedResource Include="..\..\src\Capacitor.Cli\Commands\WatchCommand.cs"
                          LogicalName="guarded.WatchCommand.cs" />
    </ItemGroup>
</Project>
